# This file is a documentation template only. Never place real credentials here.
# Cloudflare Worker development reads local values from .dev.vars instead.
# For production, set secrets with `npx wrangler secret put SECRET_NAME`.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_ORIGIN=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_TOKEN=

# Instagram Login API credentials (server-side only)
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_API_VERSION=v26.0
MEDIA_URL_SECRET=generate-a-long-random-secret

# R2 S3 API credentials used only to sign short-lived, object-scoped upload URLs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MEDIA_BUCKET=insta-portal-media
